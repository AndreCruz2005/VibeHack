{
  "name": "vibehack",
  "version": "1.0.0",
  "description": "Sistema de Escolha de Instituições de Ensino Superior",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:front\" \"npm run dev:back\"",
    "dev:front": "cd front && npm run dev",
    "dev:back": "cd back && npm start",
    "install:all": "npm install && cd front && npm install && cd ../back && npm install",
    "build": "cd front && npm run build",
    "preview": "cd front && npm run preview",
    "lint": "cd front && npm run lint",
    "start": "npm run dev"
  },
  "keywords": [
    "education",
    "universities",
    "comparison",
    "react",
    "typescript",
    "nodejs"
  ],
  "author": "VibeHack Team",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/your-username/vibehack.git"
  },
  "bugs": {
    "url": "https://github.com/your-username/vibehack/issues"
  },
  "homepage": "https://github.com/your-username/vibehack#readme"
} 