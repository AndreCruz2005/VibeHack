                            <div>
                                <h3 class="font-bold text-xl text-red-500 dark:text-red-400 mb-3 flex items-center"><svg class="h-6 w-6 mr-2" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"></path></svg> Contras</h3>
                                <ul class="list-disc list-inside space-y-2 text-gray-700 dark:text-gray-300 text-base">
                                    ${uni.cons.map(c => `<li>${c}</li>`).join('')}
                                </ul>
                            </div>
                        </div>

                        <div class="mt-6 pt-6 border-t border-gray-200 dark:border-gray-700">
                            <h3 class="font-bold text-xl text-gray-900 dark:text-gray-100 mb-3">Cursos Oferecidos</h3>
                            <div class="flex flex-wrap gap-2">
                                ${uni.courses.map(course => `<span class="bg-blue-100 dark:bg-blue-900/30 text-blue-800 dark:text-blue-300 text-sm font-medium px-3 py-1 rounded-full">${course}</span>`).join('')}
                            </div>
                        </div>

                        <div class="mt-6 pt-6 border-t border-gray-200 dark:border-gray-700">
                            <h3 class="font-bold text-xl text-gray-900 dark:text-gray-100 mb-3">Bolsas e Financiamentos</h3>
                            <ul class="list-disc list-inside space-y-2 text-gray-700 dark:text-gray-300 text-base">
                                ${uni.scholarships.map(s => `<li>${s.type.charAt(0).toUpperCase() + s.type.slice(1)} ${s.discount > 0 ? `(${s.discount}% de desconto)` : ''}</li>`).join('')}
                            </ul>
                        </div>
                    </div>
                    <div class="px-6 md:px-8 py-4 bg-gray-100 dark:bg-gray-700/50 text-right rounded-b-xl">
                        <button class="close-modal-btn bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-5 rounded-lg transition-colors duration-300 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-opacity-50 shadow-md">Fechar</button>
                    </div>
                `;
                document.getElementById('detailsModalContent').innerHTML = content;
                openModal(detailsModal);

                detailsModal.querySelectorAll('.close-modal-btn').forEach(btn => btn.addEventListener('click', () => closeModal(detailsModal)));
            }

            // --- Quiz Logic ---
            var quizScores; 
            var quizStep;   

            function startQuiz() {
                quizScores = { "Humanas": 0, "Comunicação": 0, "Negócios": 0, "Exatas": 0, "Tecnologia": 0, "Saúde": 0, "Artes": 0, "Design": 0, "Arquitetura": 0, "Direito": 0, "Gestão": 0, "Medicina": 0, "Enfermagem": 0, "Psicologia": 0, "Serviço Social": 0, "Marketing": 0, "Empreendedorismo": 0, "Jornalismo": 0, "Publicidade": 0, "Engenharia": 0, "Sistemas de Informação": 0, "Filosofia": 0, "Pesquisa": 0, "Educação": 0 };
                quizStep = 0;
                quizResultContainer.classList.add('hidden');
                quizStepContainer.classList.remove('hidden');
                renderQuizStep();
                openModal(quizModal);
            }
            
            function renderQuizStep() {
                if (quizStep >= quizQuestions.length) {
                    calculateQuizResult();
                    return;
                }

                const currentQuestion = quizQuestions[quizStep];
                let content = `
                    <div class="flex justify-between items-center mb-4">
                        <h3 class="text-2xl font-bold text-gray-900 dark:text-gray-100">Quiz Vocacional</h3>
                        <button class="close-quiz-btn p-2 text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-200 text-3xl leading-none focus:outline-none focus:ring-2 focus:ring-blue-500 rounded-full">&times;</button>
                    </div>
                    <p class="font-semibold mb-1 text-blue-600 dark:text-blue-400">Pergunta ${quizStep + 1}/${quizQuestions.length}</p>
                    <p class="mb-6 text-gray-800 dark:text-gray-200 text-lg">${currentQuestion.question}</p>
                    <div class="space-y-3">
                        ${Object.entries(currentQuestion.answers).map(([answer, areas]) => `
                            <button data-areas='${JSON.stringify(areas)}' class="quiz-answer-btn w-full text-left p-3 bg-gray-100 dark:bg-gray-700 hover:bg-blue-100 dark:hover:bg-blue-900/30 rounded-lg transition-colors duration-200 shadow-sm text-gray-800 dark:text-gray-200 focus:outline-none focus:ring-2 focus:ring-blue-500">
                                ${answer}
                            </button>
                        `).join('')}
                    </div>
                    <div class="mt-6 text-center">
                        <button id="prevQuizBtn" class="bg-gray-200 hover:bg-gray-300 dark:bg-gray-700 dark:hover:bg-gray-600 text-gray-800 dark:text-gray-200 font-bold py-2 px-5 rounded-lg transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-gray-500 ${quizStep === 0 ? 'opacity-50 cursor-not-allowed' : ''}" ${quizStep === 0 ? 'disabled' : ''}>
                            Voltar
                        </button>
                    </div>
                `;
                quizStepContainer.innerHTML = content;

                quizStepContainer.querySelectorAll('.quiz-answer-btn').forEach(btn => {
                    btn.addEventListener('click', (e) => {
                        const areas = JSON.parse(e.target.dataset.areas);
                        areas.forEach(area => {
                            if (quizScores[area] !== undefined) {
                                quizScores[area]++;
                            }
                        });
                        quizStep++;
                        renderQuizStep();
                    });
                });

                document.querySelector('.close-quiz-btn').addEventListener('click', () => closeModal(quizModal));
                document.getElementById('prevQuizBtn').addEventListener('click', () => {
                    if (quizStep > 0) {
                        quizStep--;
                        // A more robust undo would require storing previous choices or re-calculating from start
                        // For simplicity, we just go back, scores remain accumulated.
                        renderQuizStep();
                    }
                });
            }
            
            function calculateQuizResult() {
                const sortedScores = Object.entries(quizScores).sort(([, scoreA], [, scoreB]) => scoreB - scoreA);
                const topAreas = sortedScores.slice(0, 3).filter(([, score]) => score > 0);

                let resultHtml = `
                    <div class="flex justify-between items-center mb-4">
                        <h3 class="text-2xl font-bold text-gray-900 dark:text-gray-100">Seu Resultado Vocacional</h3>
                        <button class="close-quiz-btn p-2 text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-200 text-3xl leading-none focus:outline-none focus:ring-2 focus:ring-blue-500 rounded-full">&times;</button>
                    </div>
                    <p class="mb-4 text-gray-700 dark:text-gray-300">Com base nas suas respostas, as áreas que mais se destacam para você são:</p>
                `;

                if (topAreas.length === 0) {
                    resultHtml += `<p class="text-lg font-semibold text-orange-500">Não foi possível determinar uma área clara. Tente novamente!</p>`;
                } else {
                    resultHtml += `<ul class="list-disc list-inside text-left mx-auto max-w-xs space-y-2 mb-6">`;
                    topAreas.forEach(([area, score], index) => {
                        resultHtml += `<li class="text-lg font-semibold text-blue-600 dark:text-blue-400">${index + 1}. ${area}</li>`;
                    });
                    resultHtml += `</ul>`;
                    resultHtml += `<p class="text-sm text-gray-600 dark:text-gray-400">Lembre-se que este é um guia. Explore os cursos relacionados a essas áreas em nossa plataforma!</p>`;
                }
                
                resultHtml += `
                    <div class="mt-6 text-center">
                        <button id="restartQuizBtn" class="bg-yellow-500 hover:bg-yellow-600 text-gray-900 font-bold py-2 px-5 rounded-lg transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-yellow-500 shadow-md mr-3">
                            Refazer Quiz
                        </button>
                        <button class="close-quiz-btn bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-5 rounded-lg transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-blue-500 shadow-md">
                            Fechar
                        </button>
                    </div>
                `;

                quizResultContainer.innerHTML = resultHtml;
                quizStepContainer.classList.add('hidden');
                quizResultContainer.classList.remove('hidden');

                document.querySelector('.close-quiz-btn').addEventListener('click', () => closeModal(quizModal));
                document.getElementById('restartQuizBtn').addEventListener('click', startQuiz);
            }

            // --- Course Section Logic ---
            function renderCourseCards(filteredCourses) {
                courseResults.innerHTML = '';
                if (filteredCourses.length === 0) {
                    noCourseResults.classList.remove('hidden');
                } else {
                    noCourseResults.classList.add('hidden');
                }

                filteredCourses.forEach(course => {
                    const card = document.createElement('div');
                    card.className = 'bg-white dark:bg-gray-800 rounded-xl shadow-lg overflow-hidden transform hover:scale-[1.02] transition-transform duration-300 border border-gray-100 dark:border-gray-700';
                    card.innerHTML = `
                        <img src="${course.image}" alt="Imagem do curso de ${course.name}" class="w-full h-40 object-cover">
                        <div class="p-5">
                            <h3 class="text-xl font-bold text-blue-700 dark:text-blue-400 mb-2">${course.name}</h3>
                            <p class="text-sm text-gray-600 dark:text-gray-400 mb-3">${course.area}</p>
                            <p class="text-gray-700 dark:text-gray-300 text-sm mb-4">${course.description.substring(0, 100)}...</p>
                            <div class="flex justify-between items-center text-xs text-gray-500 dark:text-gray-400">
                                <span>Duração: ${course.duration}</span>
                                <span>Modalidade: ${course.modality}</span>
                            </div>
                        </div>
                    `;
                    courseResults.appendChild(card);
                });
            }

            function filterCourses() {
                const searchTerm = courseSearch.value.toLowerCase();
                const filtered = allCourses.filter(course => 
                    course.name.toLowerCase().includes(searchTerm) || 
                    course.area.toLowerCase().includes(searchTerm) ||
                    course.description.toLowerCase().includes(searchTerm)
                );
                renderCourseCards(filtered);
            }

            // --- Blog Section Logic ---
            function renderBlogPosts() {
                blogPostsContainer.innerHTML = '';
                blogPosts.forEach(post => {
                    const card = document.createElement('div');
                    card.className = 'bg-white dark:bg-gray-800 rounded-xl shadow-lg overflow-hidden transform hover:scale-[1.02] transition-transform duration-300 border border-gray-100 dark:border-gray-700';
                    card.innerHTML = `
                        <img src="${post.image}" alt="Imagem do artigo: ${post.title}" class="w-full h-40 object-cover">
                        <div class="p-5">
                            <h3 class="text-xl font-bold text-blue-700 dark:text-blue-400 mb-2">${post.title}</h3>
                            <p class="text-sm text-gray-600 dark:text-gray-400 mb-3">Por ${post.author} em ${post.date}</p>
                            <p class="text-gray-700 dark:text-gray-300 text-sm mb-4">${post.summary}</p>
                            <a href="#" class="text-blue-500 hover:underline font-medium text-sm">Ler mais</a>
                        </div>
                    `;
                    blogPostsContainer.appendChild(card);
                });
            }

            // --- Contact Form Logic ---
            contactForm.addEventListener('submit', (e) => {
                e.preventDefault();
                const name = document.getElementById('contactName').value;
                const email = document.getElementById('contactEmail').value;
                const subject = document.getElementById('contactSubject').value;
                const message = document.getElementById('contactMessage').value;

                console.log('Mensagem de Contato Recebida:', { name, email, subject, message });
                
                contactMessageStatus.classList.remove('hidden', 'text-red-500');
                contactMessageStatus.classList.add('text-green-600');
                contactMessageStatus.textContent = 'Mensagem enviada com sucesso! Em breve entraremos em contato.';
                contactForm.reset();

                setTimeout(() => {
                    contactMessageStatus.classList.add('hidden');
                }, 5000);
            });


            // --- Initial Calls and Event Listeners ---
            initMap();
            applyFilters(); // Render initial university cards and map markers
            renderCourseCards(allCourses); // Render initial course cards
            renderBlogPosts(); // Render initial blog posts

            // Navigation event listeners
            navLinks.forEach(link => {
                link.addEventListener('click', (e) => {
                    e.preventDefault();
                    showSection(e.target.dataset.section);
                });
            });

            // Home section buttons to navigate
            homeSectionButtons.forEach(button => {
                button.addEventListener('click', (e) => {
                    showSection(e.target.dataset.sectionBtn);
                });
            });

            // Quiz button listeners
            openQuizBtnFloating.addEventListener('click', startQuiz);
            openQuizBtnHome.addEventListener('click', startQuiz);

            // Course search listener
            courseSearch.addEventListener('input', filterCourses);

            // Show initial section (Home)
            showSection('home');
        });
    </script>
</body>
</html>
