<!DOCTYPE html>
<html lang="pt-BR" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Estima – Guia Inteligente de Universidades Privadas</title>
    
    <!-- Tailwind CSS via CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- Leaflet CSS for Interactive Map -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
    
    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">

    <!-- Custom Styles and Dark Mode Logic -->
    <style>
        body {
            font-family: 'Inter', sans-serif;
        }
        /* Custom scrollbar for better aesthetics */
        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #f1f1f1;
            border-radius: 10px;
        }
        ::-webkit-scrollbar-thumb {
            background: #888;
            border-radius: 10px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #555;
        }
        .dark ::-webkit-scrollbar-track {
            background: #2d3748;
        }
        .dark ::-webkit-scrollbar-thumb {
            background: #718096;
        }
        /* Leaflet map height */
        #interactiveMap {
            height: 450px; /* Increased height for better visibility */
            width: 100%;
        }
        /* Floating button style */
        .floating-btn {
            position: fixed;
            bottom: 1.5rem;
            right: 1.5rem;
            z-index: 50;
        }
        /* Modal styles */
        .modal {
            transition: opacity 0.3s ease, transform 0.3s ease;
            opacity: 0;
            transform: translateY(20px);
            pointer-events: none;
        }
        .modal.active {
            opacity: 1;
            transform: translateY(0);
            pointer-events: auto;
        }
        /* Page sections */
        .page-section {
            display: none;
        }
        .page-section.active {
            display: block;
        }
        /* Simple bounce animation for floating button */
        @keyframes bounce-slow {
            0%, 100% {
                transform: translateY(0);
            }
            50% {
                transform: translateY(-8px);
            }
        }
        .animate-bounce-slow {
            animation: bounce-slow 3s infinite ease-in-out;
        }
    </style>
</head>
<body class="bg-gray-50 dark:bg-gray-900 text-gray-800 dark:text-gray-100 transition-colors duration-300">

    <!-- Header -->
    <header class="bg-white dark:bg-gray-800 shadow-lg sticky top-0 z-40">
        <nav class="container mx-auto px-6 py-4 flex justify-between items-center">
            <div class="text-3xl font-extrabold text-blue-600 dark:text-blue-400">
                Estima<span class="text-yellow-500">.</span>
            </div>
            <div class="flex items-center space-x-6">
                <a href="#home" class="nav-link text-gray-600 dark:text-gray-300 hover:text-blue-600 dark:hover:text-blue-400 font-semibold transition-colors duration-200" data-section="home">Home</a>
                <a href="#universities" class="nav-link text-gray-600 dark:text-gray-300 hover:text-blue-600 dark:hover:text-blue-400 font-semibold transition-colors duration-200" data-section="universities">Universidades</a>
                <a href="#courses" class="nav-link text-gray-600 dark:text-gray-300 hover:text-blue-600 dark:hover:text-blue-400 font-semibold transition-colors duration-200" data-section="courses">Cursos</a>
                <a href="#scholarships" class="nav-link text-gray-600 dark:text-gray-300 hover:text-blue-600 dark:hover:text-blue-400 font-semibold transition-colors duration-200" data-section="scholarships">Bolsas & Financiamentos</a>
                <a href="#blog" class="nav-link text-gray-600 dark:text-gray-300 hover:text-blue-600 dark:hover:text-blue-400 font-semibold transition-colors duration-200" data-section="blog">Blog</a>
                <a href="#contact" class="nav-link text-gray-600 dark:text-gray-300 hover:text-blue-600 dark:hover:text-blue-400 font-semibold transition-colors duration-200" data-section="contact">Contato</a>
                <button id="darkModeToggle" aria-label="Alternar modo escuro" class="p-2 rounded-full hover:bg-gray-200 dark:hover:bg-gray-700 transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-blue-500">
                    <!-- Sun Icon -->
                    <svg id="sunIcon" class="h-6 w-6 text-yellow-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
                    <!-- Moon Icon -->
                    <svg id="moonIcon" class="h-6 w-6 text-blue-500 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/></svg>
                </button>
            </div>
        </nav>
    </header>

    <main class="container mx-auto p-4 md:p-6">
        <!-- Home Section -->
        <section id="home" class="page-section active text-center my-10 md:my-16 bg-gradient-to-r from-blue-50 to-indigo-50 dark:from-gray-800 dark:to-gray-900 p-8 rounded-xl shadow-lg">
            <h1 class="text-4xl md:text-5xl font-extrabold text-blue-700 dark:text-blue-400 leading-tight mb-4">
                Bem-vindo(a) à <span class="text-yellow-600 dark:text-yellow-400">Estima</span>: Seu Guia Completo para o Ensino Superior!
            </h1>
            <p class="mt-4 text-lg max-w-3xl mx-auto text-gray-700 dark:text-gray-300">
                Encontre a universidade ideal, explore cursos, descubra bolsas e financiamentos, e receba dicas valiosas para o seu futuro acadêmico.
            </p>
            <div class="mt-10 flex flex-wrap justify-center gap-4">
                <button class="bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 px-6 rounded-lg transition-colors duration-300 shadow-md transform hover:scale-105" data-section-btn="universities">
                    <svg class="inline-block h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a2 2 0 012-2h2a2 2 0 012 2v5m-4 0h4"></path></svg>
                    Buscar Universidades
                </button>
                <button class="bg-green-600 hover:bg-green-700 text-white font-bold py-3 px-6 rounded-lg transition-colors duration-300 shadow-md transform hover:scale-105" data-section-btn="courses">
                    <svg class="inline-block h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.747 0-3.332.477-4.5 1.253"></path></svg>
                    Explorar Cursos
                </button>
                <button id="openQuizBtnHome" class="bg-yellow-500 hover:bg-yellow-600 text-gray-900 font-bold py-3 px-6 rounded-lg transition-colors duration-300 shadow-md transform hover:scale-105">
                    <svg class="inline-block h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M6.343 17.657l-.707.707m12.728 0l-.707-.707M6.343 6.343l-.707-.707m12.728 0l.707.707M3 12h1m16 0h1M4.636 4.636l.707.707M19.364 19.364l.707.707M12 6.586l2.828 2.828A4 4 0 0116 12a4 4 0 11-8 0 4 4 0 011.172-2.586L12 6.586z" /></svg>
                    Fazer Quiz Vocacional
                </button>
            </div>
        </section>

        <!-- Universities Section (Existing content, now a page-section) -->
        <section id="universities" class="page-section">
            <h2 class="text-3xl font-bold text-center text-blue-600 dark:text-blue-400 mb-8">Encontre sua Universidade Ideal</h2>
            <div id="filters-universities" class="grid grid-cols-1 lg:grid-cols-12 gap-8">
                <aside class="lg:col-span-4 xl:col-span-3">
                    <div class="bg-white dark:bg-gray-800 p-6 rounded-xl shadow-xl sticky top-24 border border-gray-100 dark:border-gray-700">
                        <h3 class="text-2xl font-bold mb-4 border-b pb-2 border-gray-200 dark:border-gray-700 text-gray-900 dark:text-gray-100">Filtros Inteligentes</h3>
                        <div class="space-y-6">
                            <div>
                                <label for="locationFilter" class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-1">Cidade/Bairro</label>
                                <input type="text" id="locationFilter" placeholder="Ex: Recife, Boa Viagem..." class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm dark:bg-gray-700 dark:border-gray-600 dark:text-gray-100 p-2">
                            </div>
                            <div>
                                <label for="courseFilter" class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-1">Curso Desejado</label>
                                <input type="text" id="courseFilter" placeholder="Ex: Direito, Enfermagem..." class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm dark:bg-gray-700 dark:border-gray-600 dark:text-gray-100 p-2">
                            </div>
                            <div>
                                <label for="costFilter" class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-1">Custo Máximo Mensal: <span id="costValue" class="font-bold text-blue-600 dark:text-blue-400">R$ 5000</span></label>
                                <input type="range" id="costFilter" min="500" max="5000" step="100" value="5000" class="w-full h-2 bg-gray-200 rounded-lg appearance-none cursor-pointer dark:bg-gray-600 accent-blue-500">
                            </div>
                            <div>
                                <label for="scholarshipFilter" class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-1">Tipo de Bolsa</label>
                                <select id="scholarshipFilter" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm dark:bg-gray-700 dark:border-gray-600 dark:text-gray-100 p-2">
                                    <option value="todas">Todas</option>
                                    <option value="prouni">Prouni</option>
                                    <option value="bolsasocial">Bolsa Social</option>
                                    <option value="financiamento">Financiamento</option>
                                    <option value="convenio">Convênio</option>
                                </select>
                            </div>
                            <div>
                                <label for="distanceFilter" class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-1">Distância de Você: <span id="distanceValue" class="font-bold text-blue-600 dark:text-blue-400">100 km</span></label>
                                <input type="range" id="distanceFilter" min="1" max="100" step="5" value="100" class="w-full h-2 bg-gray-200 rounded-lg appearance-none cursor-pointer dark:bg-gray-600 accent-blue-500">
                            </div>
                            <div>
                                <label for="sortBy" class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-1">Ordenar por</label>
                                <select id="sortBy" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm dark:bg-gray-700 dark:border-gray-600 dark:text-gray-100 p-2">
                                    <option value="default">Relevância</option>
                                    <option value="cost-asc">Custo (menor para maior)</option>
                                    <option value="cost-desc">Custo (maior para menor)</option>
                                    <option value="mec-desc">Nota MEC (maior para menor)</option>
                                    <option value="distance-asc">Distância (menor para maior)</option>
                                </select>
                            </div>
                            <button id="clearFiltersBtn" class="w-full bg-gray-200 hover:bg-gray-300 dark:bg-gray-700 dark:hover:bg-gray-600 text-gray-800 dark:text-gray-200 font-bold py-2 px-4 rounded-lg transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-gray-500">
                                Limpar Filtros
                            </button>
                        </div>
                    </div>
                </aside>

                <div class="lg:col-span-8 xl:col-span-9 space-y-8">
                    <section class="bg-white dark:bg-gray-800 p-4 rounded-xl shadow-xl border border-gray-100 dark:border-gray-700">
                        <h2 class="text-2xl font-bold mb-2 text-gray-900 dark:text-gray-100">Mapa Interativo</h2>
                        <p class="mb-4 text-sm text-gray-600 dark:text-gray-400">
                            Veja as universidades no mapa. O ponto azul representa sua localização (simulada no bairro do Ibura, Recife para demonstração).
                        </p>
                        <div id="interactiveMap" class="rounded-lg z-0"></div>
                    </section>

                    <section>
                        <h2 class="text-2xl font-bold mb-4 text-gray-900 dark:text-gray-100">Resultados (<span id="resultsCount">0</span> encontrados)</h2>
                        <div id="universityResults" class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-2 gap-6">
                            <!-- University cards will be injected here by JavaScript -->
                        </div>
                        <div id="noResults" class="hidden text-center py-10 px-6 bg-white dark:bg-gray-800 rounded-lg shadow-md border border-gray-100 dark:border-gray-700">
                            <p class="font-semibold text-gray-700 dark:text-gray-300">Nenhuma universidade encontrada com os filtros selecionados.</p>
                            <p class="text-sm text-gray-600 dark:text-gray-400 mt-2">Tente ampliar sua busca ou ajustar os filtros.</p>
                        </div>
                    </section>
                </div>
            </div>
        </section>

        <!-- Courses Section (New) -->
        <section id="courses" class="page-section">
            <h2 class="text-3xl font-bold text-center text-blue-600 dark:text-blue-400 mb-8">Explore Nossos Cursos</h2>
            <div class="max-w-4xl mx-auto mb-8">
                <input type="text" id="courseSearch" placeholder="Buscar curso por nome ou área..." class="w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm dark:bg-gray-700 dark:border-gray-600 dark:text-gray-100 p-3">
            </div>
            <div id="courseResults" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                <!-- Course cards will be injected here -->
            </div>
            <div id="noCourseResults" class="hidden text-center py-10 px-6 bg-white dark:bg-gray-800 rounded-lg shadow-md border border-gray-100 dark:border-gray-700 mt-8">
                <p class="font-semibold text-gray-700 dark:text-gray-300">Nenhum curso encontrado com os critérios de busca.</p>
                <p class="text-sm text-gray-600 dark:text-gray-400 mt-2">Tente uma busca diferente.</p>
            </div>
        </section>

        <!-- Scholarships & Financing Section (New) -->
        <section id="scholarships" class="page-section">
            <h2 class="text-3xl font-bold text-center text-blue-600 dark:text-blue-400 mb-8">Bolsas e Financiamentos: Seu Caminho para o Ensino Superior</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                <div class="bg-white dark:bg-gray-800 p-6 rounded-xl shadow-xl border border-gray-100 dark:border-gray-700">
                    <h3 class="text-2xl font-bold text-green-600 dark:text-green-400 mb-4 flex items-center"><svg class="h-7 w-7 mr-2" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path></svg> Prouni (Programa Universidade para Todos)</h3>
                    <p class="text-gray-700 dark:text-gray-300 mb-4">Oferece bolsas de estudo integrais (100%) e parciais (50%) em cursos de graduação de instituições privadas de ensino superior. É destinado a estudantes sem diploma de nível superior, que tenham participado do ENEM e com renda familiar bruta mensal por pessoa de até 3 salários mínimos.</p>
                    <a href="https://acessounico.mec.gov.br/prouni" target="_blank" rel="noopener noreferrer" class="text-blue-500 hover:underline font-medium">Saiba mais sobre o Prouni</a>
                </div>
                <div class="bg-white dark:bg-gray-800 p-6 rounded-xl shadow-xl border border-gray-100 dark:border-gray-700">
                    <h3 class="text-2xl font-bold text-purple-600 dark:text-purple-400 mb-4 flex items-center"><svg class="h-7 w-7 mr-2" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M3 6a3 3 0 013-3h10a2 2 0 012 2v8a2 2 0 01-2 2H6a3 3 0 01-3-3V6zm4 0a1 1 0 011-1h2a1 1 0 110 2H8a1 1 0 01-1-1zm1 3a1 1 0 00-1 1v3a1 1 0 102 0v-3a1 1 0 00-1-1z" clip-rule="evenodd"></path></svg> FIES (Fundo de Financiamento Estudantil)</h3>
                    <p class="text-gray-700 dark:text-gray-300 mb-4">É um programa do Ministério da Educação que tem como objetivo conceder financiamento a estudantes de cursos superiores não gratuitos. O estudante começa a pagar o empréstimo após a formatura, com juros baixos ou zero, dependendo da renda familiar.</p>
                    <a href="https://acessounico.mec.gov.br/fies" target="_blank" rel="noopener noreferrer" class="text-blue-500 hover:underline font-medium">Saiba mais sobre o FIES</a>
                </div>
                <div class="bg-white dark:bg-gray-800 p-6 rounded-xl shadow-xl border border-gray-100 dark:border-gray-700">
                    <h3 class="text-2xl font-bold text-yellow-600 dark:text-yellow-400 mb-4 flex items-center"><svg class="h-7 w-7 mr-2" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 2a8 8 0 100 16 8 8 0 000-16zM8.707 9.293a1 1 0 00-1.414 1.414L8.586 12l-1.293 1.293a1 1 0 101.414 1.414L10 13.414l1.293 1.293a1 1 0 001.414-1.414L11.414 12l1.293-1.293a1 1 0 00-1.414-1.414L10 10.586 8.707 9.293z" clip-rule="evenodd"></path></svg> Bolsas Sociais e Convênios</h3>
                    <p class="text-gray-700 dark:text-gray-300 mb-4">Muitas universidades privadas oferecem programas de bolsas próprias, baseadas em critérios socioeconômicos ou desempenho acadêmico. Além disso, convênios com empresas, associações e escolas podem garantir descontos nas mensalidades. Verifique diretamente com a instituição de interesse.</p>
                    <p class="text-sm text-gray-600 dark:text-gray-400">Consulte o site da universidade desejada para mais informações.</p>
                </div>
                <div class="bg-white dark:bg-gray-800 p-6 rounded-xl shadow-xl border border-gray-100 dark:border-gray-700">
                    <h3 class="text-2xl font-bold text-red-600 dark:text-red-400 mb-4 flex items-center"><svg class="h-7 w-7 mr-2" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"></path></svg> Bolsas por Desempenho e Transferência</h3>
                    <p class="text-gray-700 dark:text-gray-300 mb-4">Algumas instituições oferecem bolsas para estudantes com bom desempenho no vestibular ou que transferem de outras faculdades. Essas bolsas podem ser parciais e variam de acordo com a política de cada universidade.</p>
                    <p class="text-sm text-gray-600 dark:text-gray-400">Sempre leia o edital e os requisitos de cada programa.</p>
                </div>
            </div>
        </section>

        <!-- Blog Section (New) -->
        <section id="blog" class="page-section">
            <h2 class="text-3xl font-bold text-center text-blue-600 dark:text-blue-400 mb-8">Blog Estima: Dicas e Artigos para o seu Futuro</h2>
            <div id="blogPosts" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                <!-- Blog posts will be injected here -->
            </div>
        </section>

        <!-- Contact Section (New) -->
        <section id="contact" class="page-section">
            <h2 class="text-3xl font-bold text-center text-blue-600 dark:text-blue-400 mb-8">Fale Conosco</h2>
            <div class="max-w-xl mx-auto bg-white dark:bg-gray-800 p-8 rounded-xl shadow-xl border border-gray-100 dark:border-gray-700">
                <form id="contactForm" class="space-y-6">
                    <div>
                        <label for="contactName" class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-1">Seu Nome</label>
                        <input type="text" id="contactName" class="w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm dark:bg-gray-700 dark:border-gray-600 dark:text-gray-100 p-2" required>
                    </div>
                    <div>
                        <label for="contactEmail" class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-1">Seu E-mail</label>
                        <input type="email" id="contactEmail" class="w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm dark:bg-gray-700 dark:border-gray-600 dark:text-gray-100 p-2" required>
                    </div>
                    <div>
                        <label for="contactSubject" class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-1">Assunto</label>
                        <input type="text" id="contactSubject" class="w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm dark:bg-gray-700 dark:border-gray-600 dark:text-gray-100 p-2">
                    </div>
                    <div>
                        <label for="contactMessage" class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-1">Sua Mensagem</label>
                        <textarea id="contactMessage" rows="5" class="w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm dark:bg-gray-700 dark:border-gray-600 dark:text-gray-100 p-2" required></textarea>
                    </div>
                    <button type="submit" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 px-4 rounded-lg transition-colors duration-300 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-opacity-50 shadow-md">
                        Enviar Mensagem
                    </button>
                </form>
                <div id="contactMessageStatus" class="mt-4 text-center text-sm font-semibold hidden"></div>
            </div>
        </section>

        <!-- Fraud Tips Section (Existing, now integrated as a potential internal link) -->
        <section id="fraud-tips" class="page-section mt-16 bg-white dark:bg-gray-800 p-8 rounded-xl shadow-xl border border-gray-100 dark:border-gray-700">
            <h2 class="text-3xl font-bold text-center text-red-600 dark:text-red-400 mb-8">Dicas Antifraudes: Fique Alerta! <span class="text-xl">🚨</span></h2>
