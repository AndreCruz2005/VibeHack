                    result = result.filter(uni => 
                        uni.location.cidade.toLowerCase().includes(searchLower) || 
                        uni.location.bairro.toLowerCase().includes(searchLower)
                    );
                }

                // Apply course filter
                if (filters.course) {
                    const courseLower = filters.course.toLowerCase();
                    result = result.filter(uni => uni.courses.some(c => c.toLowerCase().includes(courseLower)));
                }

                // Apply max cost filter
                result = result.filter(uni => uni.monthly_cost <= filters.maxCost);

                // Apply scholarship filter
