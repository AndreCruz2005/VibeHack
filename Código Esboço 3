                    return distance <= filters.radius;
                });

                // Apply sorting
                if (filters.sortBy === 'cost-asc') {
                    result.sort((a, b) => a.monthly_cost - b.monthly_cost);
                } else if (filters.sortBy === 'cost-desc') {
                    result.sort((a, b) => b.monthly_cost - a.monthly_cost);
